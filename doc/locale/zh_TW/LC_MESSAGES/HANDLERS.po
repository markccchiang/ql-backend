#: ../../HANDLERS.md 9d17c0c7ee9d49678d035727ee4bd97e
msgid "closed by the transport"
msgstr "由傳輸層關閉"

#: ../../HANDLERS.md df984290178d47899ce4c99afd7c86e7
msgid ""
"An `OpenSession` with a few hundred pillars exceeds uWebSockets' 16 KB "
"default"
msgstr "帶著幾百個支點的 `OpenSession` 會超過 uWebSockets 預設的 16 KB"

#: ../../HANDLERS.md 59c5e06e8ca64d0092d219b290ce246b
msgid "points per sweep"
msgstr "每次掃描的點數"

#: ../../HANDLERS.md 9605567bea45408ca174c88b9026dbe8
msgid "100,000"
msgstr ""

#: ../../HANDLERS.md 11cd898786f74171a408a1bad00de60a
#: 43ed337985f24d4b9c3fa0bfe55fbeb5
