msgstr ""

#: ../../DESIGN.md:48 e9a373ee9c6a4b90bbe6ef58ec535eea
msgid "A killed or dead worker: it is what a replay is made of"
msgstr ""

#: ../../DESIGN.md:48 4875df97aca14fd59fdeeaf71a6267a4
msgid "The resume token, and the `SessionOpened` a resume answers with"
msgstr ""

#: ../../DESIGN.md:48 660ca21d2db04fa881a12be71bbd23db
msgid "The gateway, per session (§9.4)"
msgstr ""

#: ../../DESIGN.md:48 ada93a3f61024d7a94149ecd6027ccd3
msgid "The socket, for the window. Nothing else"
msgstr ""

#: ../../DESIGN.md:48 bc9b21529c58434fb76db64704ca86ed
msgid "Outstanding `request_id`s"
msgstr ""

#: ../../DESIGN.md:48 f6494f57cd9c4594b8a1f66b6b9c90bf
msgid "The gateway, per session (§9.5)"
msgstr ""

#: ../../DESIGN.md:48 b99fc57550db4035ab5a81102df29437
msgid "Nothing: they are what a disrupted session has to fail"
msgstr ""

#: ../../DESIGN.md:48 b97a575601c44e4e8eface30b0bb5a8c
