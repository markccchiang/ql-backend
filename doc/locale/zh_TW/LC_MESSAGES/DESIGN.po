msgid "What sets it"
msgstr "由什麼決定"

#: ../../DESIGN.md:347 075c65946fc34b39ad4a5a30e84db8e6
msgid "connection : session"
msgstr "連線 : 工作階段"

#: ../../DESIGN.md:347 3a96d1e6248a4460b9731362a50edc8d
msgid "1 : N"
msgstr ""

#: ../../DESIGN.md:347 37711babdfb44be28b8c8d794e716676
msgid "one socket multiplexes them"
msgstr "一條連線多工承載它們"

